NODE_ENV=development
PORT=3000
GEMINI_API_KEY=your_gemini_api_key_here
DATABASE_URL=postgres://postgres:password@localhost:5432/smart_commerce
# Optional database alternatives:
# SUPABASE_DB_URL=postgresql://postgres.<project_ref>:password@aws-0-<region>.pooler.supabase.com:6543/postgres
# DB_SSL=true
# Notes:
# - If GEMINI_API_KEY is missing, AI endpoints automatically fall back to deterministic local responses.
# - If DATABASE_URL / SUPABASE_DB_URL is missing, the dashboard runs against seeded mock data.
